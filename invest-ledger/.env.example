# 이 파일을 복사해서 .env.local 로 이름을 바꾼 뒤 값을 채우세요. (.env.local 은 GitHub 에 올라가지 않습니다)
# Vercel 에서는 Project Settings > Environment Variables 에 같은 이름으로 입력합니다.

# Supabase > Project Settings > API (또는 Data API) 의 Project URL
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co

# Supabase > Project Settings > API Keys 의 secret 키 (sb_secret_... ) 또는 예전 방식 service_role 키
# 서버에서만 사용합니다. 절대 NEXT_PUBLIC_ 을 붙이지 마세요.
SUPABASE_SECRET_KEY=

# 로그인 기능(5단계) 전까지 사이트 전체를 보호하는 관리자 아이디/비밀번호
ADMIN_USER=admin
ADMIN_PASSWORD=
