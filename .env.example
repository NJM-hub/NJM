# Supabase 프로젝트 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# 서버 전용. 절대 NEXT_PUBLIC_ 로 노출하지 말 것
SUPABASE_SERVICE_ROLE_KEY=

# 주민번호·계좌번호 암호화 키 (openssl rand -base64 32). 분실하면 복호화 불가 → 안전하게 백업
PII_ENCRYPTION_KEY=

# (선택) 카카오 로컬 API REST 키 - 주소/호텔명을 좌표로 바꿔 거리 기반 배차에 사용
KAKAO_REST_API_KEY=
