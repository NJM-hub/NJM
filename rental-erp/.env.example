# DB 주소 (Vercel 에서 Supabase 를 연결하면 POSTGRES_URL 이 자동으로 들어오므로 비워도 됨)
# Supabase → Project Settings → Database → Connection string (Transaction pooler, 6543 포트)
DATABASE_URL=

# 처음 관리자 계정을 만들 때 본인 확인용 비밀번호 (내가 정함)
SETUP_PASSWORD=

# (선택) 계약서 AI 자동 인식 · AI 질문: Anthropic API 키 (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# (선택) 매일 아침 자동 청구·알림 (Vercel Cron) 보호용 비밀값
CRON_SECRET=

# (선택) 화면에 보일 이름
NEXT_PUBLIC_APP_NAME=(주)우정임대관리

# (선택) 로그인 쿠키 서명 키. 없으면 DB 주소로 만든다
SESSION_SECRET=
